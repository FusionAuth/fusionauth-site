---
import { getCollection, render } from "astro:content";
import Layout from "/src/layouts/Article.astro";
import RelatedContent from '/src/components/RelatedContent.astro';

export async function getStaticPaths() {
  const entries = await getCollection("articles");
  return entries.map(entry => {
    let slug = entry.id.replace(/^\/docs\//, '');

    if (slug === 'index') {
      slug = undefined;
    }

    if (slug && slug.endsWith('/index')) {
      slug = slug.replace(/\/index$/, '');
    }

    return {
      params: { slug }, 
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const isIndexPage = entry.id === 'index' || entry.id.endsWith('/index');
---
<Layout frontmatter={entry.data} {headings} {isIndexPage} id={entry.id}>
  <Content/>
  <RelatedContent tags={entry.data.tags} currentId={entry.id} collection="articles" />
</Layout>

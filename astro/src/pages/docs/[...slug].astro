---
import { getCollection, render } from "astro:content";
import Layout from '/src/layouts/Docs.astro';

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .filter(entry => entry.data.route !== false)
    .map(entry => {
      let clientToc;
      let slug = entry.id.replace(/^\/docs\//, '');
      if (entry.data.clientToc) {
        clientToc = entry.data.clientToc
      } else {
        clientToc = (slug.startsWith("apis") || slug.includes('sdks/') ) ? true : false;
      }
      
      // root index page (/docs/)
      if (slug === 'index') {
        slug = undefined;
      }

      if (slug && slug.endsWith('/index')) {
        slug = slug.replace(/\/index$/, '');
      }

      return {
        params: { slug },
        props: { entry, clientToc },
      };
    });
}

const { entry, clientToc } = Astro.props;
const { Content, headings } = await render(entry);

const isIndexPage = entry.id === 'index' || entry.id.endsWith('/index');
---
<Layout frontmatter={entry.data} {clientToc} {headings} {isIndexPage} disableTOC={entry.data.disableTOC}>
  <Content />
</Layout>

---
import { Marked } from "marked";
import { readLocalFile } from 'src/utils/localFileReader';

export interface Props {
  /**
   * File path relative to localcode (source) or src/generated-code-snippets (snippet).
   * Snippet paths contain ".snippet." in the filename.
   */
  src: string;
}

const { src } = Astro.props as Props;
const html = new Marked().parse(readLocalFile(src));
---

<article>
  <Fragment set:html={html} />
</article>

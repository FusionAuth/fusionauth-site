---
import AvailableSince from 'src/components/api/AvailableSince.astro';
import { Prism } from '@astrojs/prism';
import { getEntry, CollectionEntry, DataCollectionKey } from 'astro:content';
import { parseInline } from 'marked';

interface Props {
  title?: string;
  src: string;
}

const { title, src, since }: Props = Astro.props;

const json = await getEntry('json', src.replace('.json', '')) as CollectionEntry<DataCollectionKey>;
if (!json || !json.data) {
  console.error('Could not resolve json', src);
}
const parsedTitle = title ? parseInline(title) : '';
const content = JSON.stringify(json.data, null, 2);
---
{/* title is optional, do not render an empty em tag */}
{since && <AvailableSince since={since}/>}
{title
  ? (
    <figure class="code-figure">
      <figcaption class="code-title">{title}</figcaption>
      <Prism code={content} lang="json" code={content}/>
    </figure>
  )
  : <Prism code={content} lang="json" code={content}/>
}
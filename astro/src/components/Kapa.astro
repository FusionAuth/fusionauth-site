---
import { Icon } from "astro-iconset/components";
import FusionAuthLogo from 'src/components/FusionAuthLogo.astro';

const {
  enableKapa = true,
} = Astro.props;

if (!enableKapa) return '';
---

<div class="fixed right-5 bottom-5 z-100">
    <button id="kapa-button" class="relative flex flex-col items-center justify-center h-16 w-14 sm:h-20 sm:w-18 cursor-pointer rounded-lg border border-slate-200 dark:bg-slate-900 dark:border-slate-800 bg-white dark:hover:bg-slate-800 dark:hover:border-indigo-500 group hover:bg-slate-100 hover:border-indigo-500 overflow-hidden shadow-lg">
        <FusionAuthLogo class="size-7 sm:size-9 group-hover:scale-110 transition-transform duration-500 text-slate-700 dark:text-white" />
        <span class="text-sm sm:text-lg">Ask AI</span>
    </button>
</div>

<script is:inline>
  (function() {
    // Register the astro:before-swap unmount handler once per page lifecycle.
    // It resets Kapa's internal render handler so re-rendering works after a
    // view-transition replaces <body> and destroys the React root.
    if (!window._kapaListening) {
      window._kapaListening = true;
      document.addEventListener('astro:before-swap', function() {
        if (window.Kapa) window.Kapa('unmount');
      });
    }

    var btn = document.getElementById('kapa-button');
    if (!btn) return;

    btn.addEventListener('click', function() {
      // Bundle already loaded — render+open if no root yet, or just open.
      if (window.Kapa) {
        if (document.getElementById('kapa-widget-container')) {
          window.Kapa('open');
        } else {
          window.Kapa('render', { onRender: function() { window.Kapa('open'); } });
        }
        return;
      }

      // First click: inject the bundle. It won't auto-render (data-render-on-load=false),
      // so we trigger render+open explicitly in onload.
      if (document.querySelector('script[data-kapa-main]')) return;
      var s = document.createElement('script');
      s.src = '/public/kapa-widget.bundle.js';
      s.async = true;
      s.setAttribute('data-kapa-main', '');
      s.setAttribute('data-website-id', '26ad3b7e-7d94-491c-ab54-95712d1fafee');
      s.setAttribute('data-project-name', 'FusionAuth');
      s.setAttribute('data-project-color', '#0F172A');
      s.setAttribute('data-project-color-dark', '#334155');
      s.setAttribute('data-project-logo', '/img/icons/help/fa-black-logo.png');
      s.setAttribute('data-user-analytics-cookie-enabled', 'false');
      s.setAttribute('data-user-analytics-fingerprint-enabled', 'false');
      s.setAttribute('data-user-satisfaction-feedback-enabled', 'false');
      s.setAttribute('data-button-animation-enabled', 'false');
      s.setAttribute('data-mcp-server-url', 'https://ai.fusionauth.io/mcp/docs');
      s.setAttribute('data-mcp-button-hidden', 'false');
      s.setAttribute('data-button-hide', 'true');
      s.setAttribute('data-launcher-button-hidden', 'true');
      s.setAttribute('data-render-on-load', 'false');
      s.setAttribute('data-color-scheme',
        document.documentElement.classList.contains('dark') ? 'dark' : 'light');
      s.onload = function() {
        window.Kapa('render', { onRender: function() { window.Kapa('open'); } });
      };
      document.head.appendChild(s);
    });
  })();
</script>

---
import { Icon } from "astro-iconset/components";
import FusionAuthLogo from 'src/components/FusionAuthLogo.astro';

const {
  enableKapa = true,
} = Astro.props;

if (!enableKapa) return '';
---

<div class="fixed right-5 bottom-5 z-100">
    <button id="kapa-button" class="relative flex flex-col items-center justify-center h-16 w-14 sm:h-20 sm:w-18 cursor-pointer rounded-lg border border-slate-200 dark:bg-slate-900 dark:border-slate-800 bg-white dark:hover:bg-slate-800 dark:hover:border-indigo-500 group hover:bg-slate-100 hover:border-indigo-500 overflow-hidden shadow-lg">
        <FusionAuthLogo class="size-7 sm:size-9 group-hover:scale-110 transition-transform duration-500 text-slate-700 dark:text-white" />
        <span class="text-sm sm:text-lg">Ask AI</span>
        <span id="kapa-spinner" class="absolute inset-0 bg-black/10 dark:bg-black/50 transition-opacity duration-300 hidden items-center justify-center">
            <Icon name="fa7-solid:spinner" class="h-8 animate-spin [animation-duration:2s]" size={32} />
        </span>
    </button>
</div>

<script>
  (function() {
    const btn = document.getElementById('kapa-button');
    const spinner = document.getElementById('kapa-spinner');
    const scriptSrc = "https://widget.kapa.ai/kapa-widget.bundle.js";

    if (!btn) return;

    function getActiveTheme() {
      return document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    }

    function waitForContainer() {
      return new Promise((resolve) => {
        if (document.getElementById('kapa-widget-container')) {
          resolve();
          return;
        }
        const observer = new MutationObserver(() => {
          if (document.getElementById('kapa-widget-container')) {
            observer.disconnect();
            resolve();
          }
        });
        observer.observe(document.body, { childList: true, subtree: true });
      });
    }

    async function loadKapa() {
      // Already loaded — container exists
      if (document.getElementById('kapa-widget-container')) return;

      const script = document.createElement("script");
      script.src = scriptSrc;
      script.async = true;

      const attrs = {
        "data-website-id": "26ad3b7e-7d94-491c-ab54-95712d1fafee",
        "data-project-name": "FusionAuth",
        "data-project-color": "#0F172A",
        "data-project-color-dark": "#334155",
        "data-project-logo": "/img/icons/help/fa-black-logo.png",
        'data-user-analytics-cookie-enabled': "false",
        'data-button-animation-enabled': "false",
        'data-mcp-server-url': "https://ai.fusionauth.io/mcp/docs",
        'data-mcp-button-hidden': "false",
        'data-launcher-button-hidden': "true",
        'data-color-scheme': getActiveTheme(),
      };

      Object.entries(attrs).forEach(([k, v]) => script.setAttribute(k, v));
      document.head.appendChild(script);
    }

    btn.addEventListener('click', async () => {
      spinner.style.display = 'flex';

      loadKapa();
      await waitForContainer();

      if (window.Kapa) {
        window.Kapa("open");
      }

      spinner.style.display = 'none';
    });
  })();
</script>
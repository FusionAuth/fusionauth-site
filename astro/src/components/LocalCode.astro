---
// Local snippet loader for code stored in src/generated-code-snippets or localcode.
// Auto-detects: paths containing ".snippet." read from generated snippets; all others read from localcode.

import { Prism } from '@astrojs/prism';
import { readLocalFile } from 'src/utils/localFileReader';

export interface Props {
  /**
   * File path relative to localcode (source) or src/generated-code-snippets (snippet).
   * Snippet paths contain ".snippet." in the filename, e.g. "webauthn/base64url-to-buffer.snippet.base64url-to-buffer.js"
   * Source paths point directly to repo files, e.g. "fusionauth-quickstart-react-main/react-frontend-steps/1-customized/src/main.tsx"
   */
  src: string;

  /**
   * The language of your code.
   * Supports all languages listed here: https://prismjs.com/#supported-languages
   *
   * @default "plaintext"
   */
  lang: string;

  /**
   * The title of the code section, shown as a piece of text above the block.
   */
  title?: string;
}

const { src, lang = 'plaintext', title, ...rest } = Astro.props;

const snippetCode = readLocalFile(src);

---
{(title === '' || title === undefined) ? null : (<p data-title={title}><em>{title}</em></p>)}
<Prism code={snippetCode} lang={lang} {...rest}/>

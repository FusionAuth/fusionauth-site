---
import type {CollectionEntry} from 'astro:content';
interface Props {
  term: CollectionEntry<'glossary'> & {normalizedId: string};
}

const {term} = Astro.props;
const {definition, link, categories, aliases, abbreviations, standards, plan} = term.data;
const showPlan = plan && plan !== 'Community';
const planDisplayName = plan === 'Licensed Community' ? 'Community' : plan;
---
<article data-categories={categories} data-plan={showPlan ? plan : undefined} data-letter={term.normalizedId.toLocaleUpperCase()[0]} class="border border-slate-300 dark:bg-slate-900 bg-white border-solid  dark:border-slate-600 rounded-xl p-[0.4em_0.8em_0.8em_0.8em] hover:shadow-lg transition-all flex flex-col gap-6 group">
  <div>
    <h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors mt-0">{term.id}</h3>
    {categories?.length && (
      <div class="flex gap-2 mt-2">
        {categories.sort().map((category: string) => (
          <span class="bg-slate-100 rounded-md flex group items-center px-2 py-1 dark:bg-slate-700 group-[.active]:bg-indigo-600 group-[.active]:text-white text-[10px]">{category}</span>
        ))}
      </div>
    )}
  </div>
  <p class="not-prose text-slate-600 text-sm dark:text-slate-400 flex-1">
    {definition}
  </p>
  {(abbreviations?.length || aliases?.length || (standards && standards.length > 0)) && (
    <div class="flex flex-col gap-1 text-[11px] font-mono text-tertiary">
      {abbreviations?.length && (
        <span>Abbreviations: {abbreviations.join(', ')}</span>
      )}

      {aliases?.length && (
        <span>Alias: {aliases.join(', ')}</span>
      )}

      {standards && standards.length > 0 && (
        <span class="flex flex-wrap gap-1 items-center">
          {standards.length === 1 ? 'Standard:' : 'Standards:'}
          {standards.map((std: {name: string; url: string}, i: number) => (
            <span>
              <a href={std.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline inline-flex items-center gap-0.5">
                {std.name}
                <i aria-label="(external)" class="fa-solid fa-arrow-up-right-from-square text-[0.8em]"></i>
              </a>{i < standards.length - 1 ? ',' : ''}
            </span>
          ))}
        </span>
      )}
    </div>
  )}

  {(showPlan || link) && (
    <div class="flex items-center justify-between border-t border-slate-100 dark:border-slate-700 pt-4 gap-2">
      {showPlan && (
        <a href="/docs/concepts/plans-and-limits/plans-features" class="plan-badge plan-badge-licensed">{planDisplayName}</a>
      )}

      {link && (
        <span class="inline-flex whitespace-nowrap items-center text-xs flex-1 justify-end">
          {link.startsWith('http') ? (
            <a href={link} target="_blank" rel="noopener noreferrer">Read more... <i aria-label="(external)" class="fa-solid fa-arrow-up-right-from-square text-[0.8em] ml-1"></i></a>
          ) : (
            <a href={link}>Read more...</a>
          )}
        </span>
      )}
    </div>
  )}
</article>
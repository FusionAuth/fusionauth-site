---
import { getCollection } from 'astro:content';
import GlossaryCard from 'src/components/glossary/GlossaryCard.astro';

const terms = (await getCollection('glossary'))
  .map((term) => ({
    ...term,
    normalizedId: term.id.replace(/[^a-zA-Z0-9]/g, '').toLocaleLowerCase()
  }))
  .sort((a, b) => a.normalizedId.localeCompare(b.normalizedId));

const categories = [...new Set(Object.values(terms).flatMap(term => term.data.categories ?? []))]
  .sort((a, b) => a.localeCompare(b));

const groupedGlossary = Object.groupBy(terms, term => term.normalizedId.toLocaleUpperCase().charAt(0));
---

<nav class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 pt-2 pr-2">
  {categories.map(category => (
      <label for={`toggle-${category}`}
             class="relative inline-block py-2 px-4 font-medium text-sm cursor-pointer bg-gray-200 rounded-full transition-colors duration-200 ease-in-out has-checked:bg-indigo-500 has-checked:text-white dark:bg-gray-600">
        <input type="checkbox" id={`toggle-${category}`} name="category-filter" value={category} class="sr-only"/>
        <span>{category}</span>
      </label>
  ))}
</nav>

{Object.entries(groupedGlossary).map(([key, items]) => (
<section class="glossary-section" data-letter={key}>
  <h2 id={'glossary-' + key}>{key}</h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-2">
    {items?.map((term) => (
        <GlossaryCard {term}/>
    ))}
  </div>
</section>
))}

<script>
  // Matches the offset that the astro-better-toc scroll spy uses.
  const SCROLL_SHIFT = 100;

  const checkboxes = document.querySelectorAll<HTMLInputElement>('input[name="category-filter"]');
  const glossarySections = document.querySelectorAll<HTMLElement>('.glossary-section');
  let filterActive = false;

  // Hides or shows the entry for a heading in the sidebar TOC and the mobile inline TOC.
  // Letter entries (h2) and term entries (h3) both use this.
  const toggleTocEntry = (heading: HTMLElement | null, hidden: boolean) => {
    if (!heading?.id) return;
    const href = `a[href="#${CSS.escape(heading.id)}"]`;
    document.querySelectorAll<HTMLElement>(`#toc-container ${href}, [data-toc-inline] ${href}`)
      .forEach(link => link.closest('li')?.classList.toggle('hidden', hidden));
  };

  // The astro-better-toc scroll spy collects headings once at page load. Hidden headings report
  // an offsetTop of 0, so while a filter is active the spy can mark a hidden entry as active.
  // This handler runs after the spy and marks the entry for the visible heading instead.
  const syncActiveTocItem = () => {
    if (!filterActive) return;

    // querySelectorAll returns document order, which is also top-to-bottom order.
    const headings = [...document.querySelectorAll<HTMLElement>(
      '.glossary-section:not(.hidden) h2[id], .glossary-section:not(.hidden) article:not(.hidden) h3[id]'
    )];
    if (!headings.length) return;

    const scroll = document.documentElement.scrollTop;
    const active = headings.findLast(h => scroll + SCROLL_SHIFT > h.offsetTop) ?? headings[0];

    document.querySelectorAll('#toc-container [data-widget="scroll-spy-item"].active')
      .forEach(item => item.classList.remove('active'));
    document.querySelector(`#toc-container a[href="#${CSS.escape(active.id)}"]`)
      ?.closest('[data-widget="scroll-spy-item"]')
      ?.classList.add('active');
  };

  const filterChange = () => {
    const selected = Array.from(checkboxes).filter(checkbox => checkbox.checked).map(checkbox => checkbox.value);
    filterActive = selected.length > 0;

    glossarySections.forEach((section: HTMLElement) => {
      const items = section.querySelectorAll<HTMLElement>('article');
      let visibleCount = 0;
      items.forEach((item: HTMLElement) => {
        const itemCategories = item.dataset['categories']?.split(',') ?? [];
        const visible = !selected.length || itemCategories.some(category => selected.includes(category));
        item.classList.toggle('hidden', !visible);
        toggleTocEntry(item.querySelector<HTMLElement>('h3[id]'), !visible);
        if (visible) visibleCount++;
      });
      section.classList.toggle('hidden', visibleCount === 0);
      toggleTocEntry(section.querySelector<HTMLElement>('h2[id]'), visibleCount === 0);
    });

    syncActiveTocItem();
  };

  checkboxes.forEach((checkbox: HTMLInputElement) => {
    checkbox.addEventListener('change', filterChange);
  });

  document.addEventListener('scroll', () => requestAnimationFrame(syncActiveTocItem), { passive: true });
</script>

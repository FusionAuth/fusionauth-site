---
import { glossaryEntries } from 'src/plugins/glossary.mjs';
import PlanBlurbApi from 'src/components/plan/PlanBlurbApi.astro';

const groups = Object.entries(Object.groupBy(glossaryEntries, e => e.id.replace(/[^a-z0-9]/gi, '').charAt(0).toUpperCase()));
---
{groups.map(([letter, entries]) => (
  <section>
    <h2 id={`letter-${letter.toLowerCase()}`}>{letter}</h2>
    <dl class="not-prose grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3 my-0">
      {entries!.map(({ id, anchor, definitionHtml, link, abbreviations, aliases, standards, plan }) => (
        <div id={anchor} class="scroll-mt-24 flex flex-col gap-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 p-5">
          <dt class="text-base font-semibold">
            <a href={link} class="text-indigo-700 dark:text-indigo-400 hover:text-orange-800 dark:hover:text-orange-200 underline underline-offset-2">{id}</a>
          </dt>
          <dd class="text-slate-700 dark:text-slate-300 flex-1 [&_a]:text-indigo-700 dark:[&_a]:text-indigo-400 [&_a]:underline [&_a]:underline-offset-2" set:html={definitionHtml} />
          {!!abbreviations?.length && (
            <dd class="text-sm text-slate-600 dark:text-slate-400">Abbreviation: {abbreviations.join(', ')}</dd>
          )}
          {!!aliases?.length && (
            <dd class="text-sm text-slate-600 dark:text-slate-400">Also called: {aliases.join(', ')}</dd>
          )}
          {!!standards?.length && (
            <dd class="text-sm text-slate-600 dark:text-slate-400">
              Defined in: {standards.map((s, i) => (
                <>{i > 0 && ', '}<a href={s.url} class="text-indigo-700 dark:text-indigo-400 underline underline-offset-2">{s.name}</a></>
              ))}
            </dd>
          )}
          {plan && (
            <dd class="mt-auto"><PlanBlurbApi plan={plan} badge /></dd>
          )}
        </div>
      ))}
    </dl>
  </section>
))}

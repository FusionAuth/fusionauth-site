---
import { getCollection, render } from 'astro:content';
import {
  ReleaseNotes as BaseReleaseNotes,
  getCategoryColor,
  getCategoryLabel,
} from 'astro-better-release-notes';
import ReleaseNotesItem from './ReleaseNotesItem.astro';
import { releaseCategories } from 'src/tools/docs/releaseCategories';

export const categories = releaseCategories;

export { getCategoryColor, getCategoryLabel };

const allUpdates = await getCollection('releases');
const sorted = allUpdates.sort((a, b) => {
  const dateDiff = b.data.date.valueOf() - a.data.date.valueOf();
  if (dateDiff !== 0) return dateDiff;
  return b.data.version.localeCompare(a.data.version, undefined, { numeric: true });
});

const updates = await Promise.all(
  sorted.map(async item => {
    const { Content } = await render(item);
    return { data: item.data, Content };
  })
);
---

<BaseReleaseNotes
  {updates}
  {categories}
  components={{ ReleaseNotesItem }}
/>

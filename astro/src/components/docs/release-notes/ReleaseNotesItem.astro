---
import { ReleaseNotesItem as BaseItem } from 'astro-better-release-notes';
import { categories } from 'src/components/docs/release-notes/ReleaseNotes.astro';

export interface Props {
  issue?: string;
  bonusIssue?: string;
  thanks?: string;
  bonusThanks?: string;
  category: string;
  since?: string;
  resolvedIn?: string;
  viaIssue?: string;
}

const { category, ...rest } = Astro.props as Props;
const cat = categories.find(c => c.id === category);
---

<BaseItem
  {...rest}
  {category}
  categoryColor={cat?.color}
  categoryLabel={cat?.label}
  issueBaseUrl="https://github.com/FusionAuth/fusionauth-issues/issues/"
>
  <slot />
</BaseItem>

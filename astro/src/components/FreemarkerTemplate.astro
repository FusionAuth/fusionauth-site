---
import { Prism } from '@astrojs/prism';
import { parseInline } from 'marked';
import fs from 'fs';
import {CodeLanguage} from "astro";

interface Props {
  lang?: CodeLanguage;
  title?: string;
  src: string;
}

const { title, src, lang }: Props = Astro.props;

const content = fs.readFileSync(src, {encoding: 'utf-8'});

const parsedTitle = title ? parseInline(title) : '';
---
{title
  ? (
    <figure class="code-figure">
      <figcaption class="code-title" set:html={parsedTitle}/>
      <Prism lang={lang ?? "ftl"} code={content}/>
    </figure>
  )
  : (
    <div class="mb-14 prose-pre:mt-1">
      <Prism lang={lang ?? "ftl"} code={content}/>
    </div>
  )
}

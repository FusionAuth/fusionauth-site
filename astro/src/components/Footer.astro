---
import CodeCopyButton from 'astro-better-code-blocks/CopyCodeButton.astro';
import FusionAuthLogo from './FusionAuthLogo.astro';
import Kapa from 'src/components/Kapa.astro';

const { enableKapa, sections = [
  {
    "heading": "Get Started",
    "items": [
      { "label": "download locally", "href": "/docs/get-started/download-and-install/docker" },
      { "label": "FusionAuth Cloud", "href": "/docs/cloud/" },
      { "label": "quickstarts", "href": "/docs/get-started/quickstarts/" },
    ]
  },
  {
    "heading": "product",
    "items": [
      { "label": "features", "href": "/docs/get-started/core-concepts/plans-features" },
      { "label": "pricing", "href": "/pricing" },
    ]
  },
  {
    "heading": "developers",
    "items": [
      { "label": "SDKs", "href": "/docs/sdks/" },
      { "label": "API Docs", "href": "/docs/apis/" },
      { "label": "Documentation", "href": "/docs/" },
      { "label": "release notes", "href": "/docs/release-notes" },
      { "label": "trust center", "href": "https://trust.fusionauth.io/" },
    ]
  },
  {
    "heading": "resources",
    "items": [
      { "label": "support forum", "href": "https://fusionauth.io/community/forum/" },
      { "label": "FusionAuth Cloud status", "href": "https://status.fusionauth.io/" },
      { "label": "blog", "href": "/blog/" },
      { "label": "articles", "href": "/articles/" },
    ]
  }
]} = Astro.props;
---
<footer class="fa-footer">
  <div class="fa-footer-body">
    <div class="fa-footer-sections" data-footer-grid>
      <div class="fa-footer-brand">
        <div>
          <FusionAuthLogo class="size-16 shrink-0 transition-transform duration-500 text-slate-700 dark:text-white" />
          <div class="text-4xl font-semibold">
            <span class="text-white">Fusion</span><span class="text-orange-500">Auth</span>
          </div>
        </div>
      </div>
      {sections.map((section) =>
        <div class="fa-footer-section">
          <h4>{section.heading}</h4>
          <ul>
            {section.items.map((item) =>
              <li><a href={item.href}>{item.label}</a></li>
            )}
          </ul>
        </div>
      )}
    </div>

    <div class="fa-footer-social">
      <a href="https://github.com/FusionAuth"><img src="/img/footer/github.svg" alt="FusionAuth Github"></a>
      <a href="https://twitter.com/fusionauth"><img src="/img/footer/twitter.svg" alt="FusionAuth Twitter"></a>
      <a href="https://www.linkedin.com/company/fusionauth/"><img src="/img/footer/linkedin.svg" alt="FusionAuth LinkedIn"></a>
      <a href="https://www.youtube.com/@FusionAuth"><img src="/img/footer/youtube.svg" alt="FusionAuth Youtube"></a>
      <a href="https://dev.to/fusionauth"><img src="/img/footer/dev.svg" alt="FusionAuth Dev.to"></a>
    </div>

    <div class="fa-footer-legal">
      <span class="fa-footer-copy">&copy; { new Date().getFullYear() } FusionAuth. All Rights Reserved.</span>
      <span class="fa-footer-legal-links">
        <a href="https://fusionauth.io/license">License</a>
        &bull;
        <a href="https://fusionauth.io/license-faq">License FAQ</a>
        &bull;
        <a href="https://fusionauth.io/privacy-policy">Privacy</a>
        &bull;
        <a href="https://fusionauth.io/product-privacy-policy">Product Privacy Policy</a>
        &bull;
        <a href="https://fusionauth.io/cookie-policy">Cookie Policy</a>
      </span>
    </div>
  </div>

  <Kapa enableKapa={enableKapa} />
  <CodeCopyButton />
</footer>

<style>
  @reference "../css/style.css";

  .fa-footer { @apply bg-slate-900 bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-900; }
  .fa-footer-body { @apply max-w-8xl mx-auto px-4 py-8 lg:pt-10; }
  .fa-footer-sections { @apply grid grid-cols-2 gap-6 pb-10 text-center md:text-left lg:grid-cols-6 lg:pb-12 lg:pt-8; }
  .fa-footer-brand { @apply col-span-2 flex justify-center md:justify-start; }
  .fa-footer-brand > div { @apply flex items-center gap-2; }
  .fa-footer-section { @apply mb-6 md:mb-0; }
  .fa-footer-section h4 { @apply font-semibold mb-3 text-sm text-white uppercase; }
  .fa-footer-section ul { @apply capitalize font-medium text-slate-300 text-sm space-y-3; }
  .fa-footer-section a { @apply hover:text-indigo-500 transition-colors; }
  .fa-footer-social { @apply flex items-center justify-center gap-5 mb-10 mt-2 lg:justify-end lg:mb-7 lg:pr-9; }
  .fa-footer-social img { @apply w-5; }
  .fa-footer-legal { @apply border-t border-slate-400 flex flex-wrap justify-center items-center gap-4 px-4 py-6 lg:justify-between; }
  .fa-footer-copy { @apply font-medium text-gray-500 dark:text-gray-300 text-sm; }
  .fa-footer-legal-links { @apply font-medium text-slate-300 text-xs text-center; }
  .fa-footer-legal-links a { @apply mx-2 hover:text-indigo-500 transition-colors; }
</style>

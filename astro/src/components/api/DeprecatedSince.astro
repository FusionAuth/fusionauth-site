---
import { Admonition } from 'astro-better-admonitions';
import type { AdmonitionTypeConfig } from 'astro-better-admonitions';

interface Props {
  since: string;
}

const { since }: Props = Astro.props;

if (!since) throw new Error('No since field');

const hasDetail = Astro.slots.has('default');

const DEPRECATED_SINCE_TYPE: Record<string, AdmonitionTypeConfig> = {
  'deprecated-since': { label: 'Deprecated since', color: '#dc2626' },
};
---

<Admonition
  type="deprecated-since"
  types={DEPRECATED_SINCE_TYPE}
  display={hasDetail ? 'block' : 'inline'}
  titleBold={hasDetail}
>
  <Fragment slot="title">Deprecated since <code>{since}</code></Fragment>
  {hasDetail && <slot />}
</Admonition>

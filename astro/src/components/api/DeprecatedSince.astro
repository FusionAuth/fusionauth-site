---
interface Props {
  since: string
}

const { since }: Props = Astro.props;
const hasContent = Astro.slots.has("default");
---
{ since && <span class="api-deprecated italic">Deprecated since {since}</span>
<Fragment>
  {hasContent &&
    <div class="api-body"><slot></slot></div>
  }
</Fragment>
}

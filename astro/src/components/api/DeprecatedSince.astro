---
interface Props {
  since: string;
}

const { since }: Props = Astro.props;

if (!since) {
  throw new Error("No since field");
}

const hasDetail = Astro.slots.has('default');
---
{
  hasDetail ? (
    <div class="api-deprecated-block">
      <div class="api-deprecated-header">Deprecated since <code>{since}</code></div>
      <div class="aside-content">
        <slot />
      </div>
    </div>
  ) : (
    <span class="api-deprecated">Deprecated since <code>{since}</code></span>
  )
}

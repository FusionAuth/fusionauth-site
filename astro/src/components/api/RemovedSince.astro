---
import { Admonition } from 'astro-better-admonitions';
import type { AdmonitionTypeConfig } from 'astro-better-admonitions';

interface Props {
  since: string;
}

const { since }: Props = Astro.props;
const hasContent = Astro.slots.has('default');

const REMOVED_IN_TYPE: Record<string, AdmonitionTypeConfig> = {
  'removed-in': { label: 'Removed in', color: '#dc2626' },
};
---

{since && (
  <>
    <Admonition
      type="removed-in"
      types={REMOVED_IN_TYPE}
      display="inline"
    >
      <Fragment slot="title">Removed in <code>{since}</code></Fragment>
    </Admonition>
    {hasContent && <div><slot /></div>}
  </>
)}

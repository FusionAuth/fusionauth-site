---
interface Props {
  since: string;
  // only show when since > showSince; omit to always show
  // (used when a field exists in an event added later than the field itself)
  showSince?: string;
}

const { since, showSince }: Props = Astro.props;

if (!since) {
  throw new Error("No since field");
}

const semverToPaddedNumber = (semver: string) => {
  const [major, minor, patch] = semver.split('.').map(Number);
  if (isNaN(major) || isNaN(minor) || isNaN(patch)) {
    throw new Error("Invalid semver format");
  }
  return `${major}${String(minor).padStart(3, '0')}${String(patch).padStart(2, '0')}`;
};

const show = showSince === undefined || semverToPaddedNumber(since) > semverToPaddedNumber(showSince);
---
{show && <span class="api-since">Available since <code>{since}</code></span>}

---
import AvailableSince from './AvailableSince.astro';
import ReadOnly from './ReadOnly.astro';
import { marked } from 'marked';

interface Props {
  name: string;
  description?: string;
  type?: string;
  required?: boolean;
  optional?: boolean;
  immutable?: boolean;
  since?: string;
  defaults?: string;
  deprecated?: boolean;
  renderif?: boolean;
  readonly?: boolean;
  show_since?: boolean;
}

const {
  name,
  description,
  type,
  required,
  optional,
  immutable,
  since,
  defaults,
  deprecated,
  renderif = true,
  show_since = true,
  readonly
} = Astro.props;

const rawSlotContent = await Astro.slots.render('default');
let parsedMarkdownHTML = '';
if (rawSlotContent) {
  const trimmedContent = rawSlotContent.replace(/^[ \t]+/gm, '');
  parsedMarkdownHTML = marked.parse(trimmedContent);
}
---
{renderif && <div class="api-field">
  <div class="api-field-row">
    <code class="api-field-name">{name}</code>{' '}

    {type && <><code class="api-type">{type}</code>{' '}</>}
    {description && <><span class="px-3">{description}</span>{' '}</>}

    {required && <><span class="api-required">required</span>{' '}</>}
    {optional && <><span class="api-optional">optional</span>{' '}</>}
    {defaults && <><span class="api-default">Defaults to {defaults}</span>{' '}</>}

    {show_since && since && <AvailableSince since={since} />}
    {immutable && <><span class="api-immutable">Immutable</span>{' '}</>}
    {deprecated && <><span class="api-deprecated text-sm">DEPRECATED</span>{' '}</>}
    {readonly && <ReadOnly />}
  </div>

  <div class="api-body">
    <div class="api-body" set:html={parsedMarkdownHTML}></div>
  </div>
</div>}
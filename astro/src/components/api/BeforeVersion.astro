---
import { Admonition } from 'astro-better-admonitions';
import type { AdmonitionTypeConfig } from 'astro-better-admonitions';

interface Props {
  version: string;
}

const { version }: Props = Astro.props;
if (!version) throw new Error('No version field');

const hasContent = Astro.slots.has('default');

const BEFORE_VERSION_TYPE: Record<string, AdmonitionTypeConfig> = {
  'before-version': { label: 'Before version', color: '#2563eb' },
};
---

{version && (
  <>
    <Admonition
      type="before-version"
      types={BEFORE_VERSION_TYPE}
      display="inline"
    >
      <Fragment slot="title">Before version <code>{version}</code></Fragment>
    </Admonition>
    {hasContent && <div><slot /></div>}
  </>
)}

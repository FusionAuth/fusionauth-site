---
import Font from 'astro/components/Font.astro';
import SchemaMarkup from './SchemaMarkup.astro';

interface Props {
  description?: string;
  enableBaseParent?: boolean;
  enableGTM?: boolean;
  llmsTxtHref?: string;
  markdownTitle?: string;
  title?: string;
  openGraphImage?: string;
  canonicalUrl?: string;
  isIndexPage?: boolean;
  applyTheme?: boolean;
}

const {
  description,
  enableBaseParent = false,
  enableGTM = true,
  llmsTxtHref = '/docs/.well-known/llms.txt',
  markdownTitle,
  title, openGraphImage,
  canonicalUrl,
  applyTheme = true,
  isIndexPage = false,
} = Astro.props;

const openGraphImageUrl = openGraphImage ? new URL(openGraphImage, Astro.url): new URL("/img/og/articles-developers-v1.png", Astro.url);
const normalizedUrl = Astro.url.toString().replace(/\.html$/, '');
const isProd = import.meta.env.PROD as boolean;

let canonical = canonicalUrl;
if (!canonical) {
  canonical = Astro.url.href;
} else if (!canonical.startsWith('http')) {
  canonical = new URL(canonical, Astro.url).href;
}

if (canonical.endsWith('/index.html')) {
  canonical = canonical.slice(0, -'index.html'.length); // keeps trailing '/'
} else if (canonical.endsWith('.html')) {
  canonical = canonical.slice(0, -'.html'.length);
}

// Pages built from index.mdx are served as a directory (with trailing slash);
// standalone .mdx files are served without one. Match whichever URL is served.
if (isIndexPage && !canonical.endsWith('/')) {
  canonical += '/';
}

const slug = Astro.params.slug;
---
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>
  <style is:inline>
    body { background: #fff; color: #334155; }
    html.dark body { background: #0f172a; color: #e2e8f0; }
    /* hide sr-only content from humans before CSS loads */
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
    /* nav bar: same values as astro-better-nav-bar/style.css */
    #main-header { background: #0f172a; position: sticky; top: 0; z-index: 50; }
    .nav-desktop { display: none; }
    .nav-mobile { display: flex; align-items: center; padding: 0.5rem 1rem; gap: 0.5rem; }
    .nav-brand { display: flex; align-items: center; }
    .nav-actions { display: flex; align-items: center; gap: 0.5rem; }
    .nav-mobile-actions { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
    .nav-mobile-dropdowns { display: flex; align-items: center; gap: 0.5rem; }
    @media (min-width: 1024px) {
      .nav-desktop { display: flex; justify-content: space-between; align-items: center; max-width: 90rem; margin: 0 auto; padding: 0.5rem 1rem; }
      .nav-mobile { display: none; }
    }
    /* sidebar and TOC visibility */
    #side-nav { display: none; }
    [data-toc-aside] { display: none; }
    @media (min-width: 1024px) {
      #layout-outer { display: flex; align-items: flex-start; }
      #side-nav { display: block; order: -1; max-width: 270px; width: 100%; flex-shrink: 0; }
    }
    @media (min-width: 1280px) { [data-toc-aside] { display: block; } }
    /* footer: horizontal sections before grid CSS loads */
    [data-footer-grid] { display: flex; flex-wrap: wrap; gap: 1rem; }
    [data-footer-grid] > div { flex: 1; min-width: 130px; }
    /* action buttons: same values as Tailwind classes */
    [data-action-btn] {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 10px; border: 1px solid #e2e8f0; border-radius: 4px;
      font-size: 12px; color: #64748b; background: #fff;
      text-decoration: none; cursor: pointer;
    }
    html.dark [data-action-btn] { border-color: #334155; color: #94a3b8; background: #0f172a; }
  </style>
  <link rel="icon" type="image/png" href="/img/favicon.png"/>
  { canonical && <link rel="canonical" href={canonical} /> }
  <meta name="algolia-site-verification" content="857638C054AD182F" />
  <link rel="sitemap" href="/sitemap.xml">
  <link rel="alternate" type="text/plain" title="LLM Index" href={llmsTxtHref} />
  <link 
    id="llm-md-link" 
    rel="alternate" 
    type="text/markdown" 
    title="Page Markdown Source" 
    href={Astro.url.pathname + "?format=md"} 
  />
  <Font cssVariable="--font-inter-var" preload />
<script src="../scripts/Visibility.ts"></script>
  {applyTheme && <script is:inline>
    const getTheme = () => {
      const theme = localStorage?.getItem('theme');
      if (theme && theme !== 'system') {
        return theme;
      }
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    const applyThemeClass = () => {
      document.documentElement.classList.toggle('dark', getTheme() === 'dark');
    };

    // run immediately on initial load to prevent flashing
    applyThemeClass();
  </script>}
  <title>{title}</title>
  <link type="application/rss+xml" rel="alternate" href="/docs/releases.xml" title="Release Notes Feed">
  <link type="application/rss+xml" rel="alternate" href="/blog/feed.xml" title="Blog Feed">

  <meta name="description" content={description}/>
  {markdownTitle && <meta name="markdown-title" content={markdownTitle} />}
  <meta property="og:site_name" content="FusionAuth"/>
  <meta property="og:url" content={normalizedUrl}/>
  <meta property="og:description" content={description}/>
  <meta property="og:title" content={title}/>
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="en_US"/>
  <meta property="og:image" content={openGraphImageUrl}/>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@FusionAuth">
  <meta name="twitter:creator" content="@FusionAuth">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={openGraphImageUrl}>

  {isProd && enableGTM &&
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MZ9FDPFDF0" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-MZ9FDPFDF0');
    </script>
  }

  { enableBaseParent &&
    <base target="_parent"/>
  }

  <SchemaMarkup title={title} />
</head>

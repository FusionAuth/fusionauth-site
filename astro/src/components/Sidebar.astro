---
import SidebarItem from './SidebarItem.astro';

interface Props {
  frontmatter: Record<string, any>;
  collection: CollectionEntry[];
  basePath: String;
}

const { frontmatter, collection, basePath } = Astro.props;

const normalizeForMatch = (p: string | null) => {
  if (!p) return "";
  let clean = decodeURI(p);
  if (clean.startsWith(basePath)) {
    clean = clean.substring(basePath.length);
  }
  return clean
    .replace(/\.(md|mdx|html)$/i, '')
    .replace(/\/index$/i, '')
    .replace(/^\/+|\/+$/g, '');
};

const safeCurrentPath = normalizeForMatch(Astro.url.pathname);

const formatTitle = (str: string) =>
  str.split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');

function buildTree(pages: CollectionEntry[]) {
  const root: any = { 
    children: {}, 
    title: 'Documentation',
    href: basePath,
    order: -1 
  };

  for (const page of pages) {
    const { order, hidden, title: dataTitle } = page.data;
    const label = page.data?.sidebar?.label;

    if (hidden === true) continue;

    const slug = page.slug || page.id || "";
    const parts = slug.split('/');
    let current = root;

    if (slug === "index" || slug === "") {
      root.title = label || dataTitle || root.title;
      if (order !== undefined) root.order = order;
      continue;
    }

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      const isIndexFile = part === 'index';
      const isLastPart = i === parts.length - 1;

      if (isIndexFile) {
        current.title = label || dataTitle || current.title;
        current.href = `${basePath}/${slug.replace(/\/index$/, "")}`.replace(/\/+/g, '/').replace(/\/$/, "");
        if (order !== undefined) current.order = order;
        break; 
      }

      if (!current.children[part]) {
        current.children[part] = {
          name: part,
          title: formatTitle(part),
          href: null,
          children: {},
          isOpen: false,
          isActive: false,
          order: Infinity, 
        };
      }

      if (isLastPart) {
        current.children[part].title = label || dataTitle || formatTitle(part);
        const cleanSlug = slug.replace(/\.(md|mdx)$/i, '');
        current.children[part].href = `${basePath}/${cleanSlug}`.replace(/\/+/g, '/').replace(/\/$/, "");
        if (order !== undefined) current.children[part].order = order;
      }

      current = current.children[part];
    }
  }
  return root;
}

const treeRoot = buildTree(collection);

function markActiveAndOpen(node: any): boolean {
  const isDirectMatch = node.href != null && normalizeForMatch(node.href) === safeCurrentPath;
  
  node.isCurrentPage = isDirectMatch;

  let hasActiveChild = false;
  for (const key in node.children) {
    if (markActiveAndOpen(node.children[key])) {
      hasActiveChild = true;
    }
  }

  node.isActive = isDirectMatch || hasActiveChild;
  node.isOpen = node.isActive; 
  
  return node.isActive;
}

markActiveAndOpen(treeRoot);

function getSortedArray(nodeChildren: Record<string, any>) {
  const childrenArray = Object.values(nodeChildren);

  childrenArray.sort((a, b) => {
    const valA = a.order === undefined ? Infinity : a.order;
    const valB = b.order === undefined ? Infinity : b.order;
    
    if (valA !== valB) return valA - valB;
    return a.title.localeCompare(b.title);
  });

  childrenArray.forEach(child => {
    if (child.children && Object.keys(child.children).length > 0) {
      child.sortedChildren = getSortedArray(child.children);
    } else {
      child.sortedChildren = [];
    }
  });

  return childrenArray;
}

const treeArray = getSortedArray(treeRoot.children);
---

<aside class="sb-aside">
  <nav class="sb-nav">
    {treeArray.map(node => (
      <SidebarItem node={node} />
    ))}
  </nav>
</aside>

<script>
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('.sb-folder > .sb-sum > a.sb-lnk');
    
    if (link) {
      const details = link.closest('details');
      // If closed, expand section first. If open, allow standard <a> navigation.
      if (details && !details.open) {
        e.preventDefault();
        details.open = true;
      }
    }
  });
</script>

<style is:global>
  @reference "tailwindcss";

  /* LIGHT THEME */
  .sb-aside {
    @apply w-64 flex-shrink-0 h-[calc(100vh-4rem)] sticky top-16 border-r border-gray-200 bg-white pt-2 pr-2 pl-0;
  }
  .sb-nav {
    @apply flex flex-col gap-1;
  }
  .sb-sum {
    @apply flex items-center justify-between cursor-pointer list-none select-none rounded gap-1;
    text-decoration: none !important;
  }
  .sb-sum::-webkit-details-marker,
  .sb-sum::marker {
    display: none;
  }

  /* folder-style unvisitable index pages */
  .sb-sum.sb-no-link:hover {
    @apply bg-slate-100;
  }

  /* Link Base Styles */
  .sb-lnk {
    @apply flex-1 font-medium text-sm text-slate-700 py-1 px-2 rounded transition-colors no-underline;
  }
  .sb-child {
    @apply block font-medium text-sm text-slate-600 py-1 pl-4 pr-2 rounded transition-colors no-underline;
  }

  /* index pages and leaf links */
  a.sb-lnk:hover,
  a.sb-child:hover {
    @apply bg-slate-100 text-indigo-600;
  }

  /* Chevron Button Target */
  .sb-chv {
    @apply flex items-center justify-center w-7 h-7 rounded text-gray-400 transition-colors shrink-0;
  }

  /* Visitable Sections: SEPARATE Hover for Chevron Button */
  .sb-sum:not(.sb-no-link) .sb-chv:hover {
    @apply bg-slate-100 text-slate-700;
  }

  .sb-chv::after {
    content: '';
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg); /* Points Right > */
    transition: transform 0.2s ease-in-out;
    box-sizing: border-box;
  }

  details[open] > .sb-sum .sb-chv::after {
    transform: rotate(45deg); /* Points Down v */
  }

  /* Active State (aria-current) */
  .sb-lnk[aria-current="page"],
  .sb-child[aria-current="page"] {
    @apply font-semibold text-indigo-600 bg-indigo-50;
  }

  /* Ancestor Folder State */
  .sb-lnk.s-anc,
  .sb-child.s-anc {
    @apply font-semibold text-slate-900;
  }

  .sb-kids {
    @apply flex flex-col gap-0.5 pl-2;
  }

  .sb-sum:has(> [aria-current="page"]) .sb-chv {
    @apply text-indigo-500;
  }

  /* DARK THEME OVERRIDES */
  .dark .sb-aside {
    @apply border-gray-800 bg-gray-900;
  }
  .dark .sb-sum.sb-no-link:hover {
    @apply bg-slate-800;
  }
  .dark .sb-lnk {
    @apply text-slate-200;
  }
  .dark .sb-child {
    @apply text-slate-400;
  }
  .dark a.sb-lnk:hover,
  .dark a.sb-child:hover {
    @apply bg-slate-800 text-indigo-400;
  }
  .dark .sb-sum:not(.sb-no-link) .sb-chv:hover {
    @apply bg-slate-800 text-slate-200;
  }
  .dark .sb-lnk[aria-current="page"],
  .dark .sb-child[aria-current="page"] {
    @apply text-indigo-400 bg-indigo-950/40;
  }
  .dark .sb-lnk.s-anc,
  .dark .sb-child.s-anc {
    @apply text-white;
  }
</style>
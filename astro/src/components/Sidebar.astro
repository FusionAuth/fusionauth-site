---
import SidebarItem from './SidebarItem.astro';

interface Props { frontmatter: Record<string, any>; collection: CollectionEntry[]; basePath: String; }
const { frontmatter, collection, basePath } = Astro.props;

const normalizeForMatch = (p: string | null) => {
  if (!p) return "";
  let clean = decodeURI(p);
  if (clean.startsWith(basePath)) clean = clean.substring(basePath.length);
  return clean.replace(/\.(md|mdx|html)$/i, '').replace(/\/index$/i, '').replace(/^\/+|\/+$/g, '');
};

const safeCurrentPath = normalizeForMatch(Astro.url.pathname);
const formatTitle = (str: string) => str.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

function buildTree(pages: CollectionEntry[]) {
  const root: any = { children: {}, title: 'Documentation', href: basePath, order: -1 };
  for (const page of pages) {
    const { order, hidden, title: dataTitle } = page.data;
    const label = page.data?.sidebar?.label;
    if (hidden === true) continue;

    const slug = page.slug || page.id || "";
    const parts = slug.split('/');
    let current = root;

    if (slug === "index" || slug === "") {
      root.title = label || dataTitle || root.title;
      if (order !== undefined) root.order = order;
      continue;
    }

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      if (part === 'index') {
        current.title = label || dataTitle || current.title;
        current.href = `${basePath}/${slug.replace(/\/index$/, "")}`.replace(/\/+/g, '/').replace(/\/$/, "");
        if (order !== undefined) current.order = order;
        break; 
      }

      if (!current.children[part]) {
        current.children[part] = { name: part, title: formatTitle(part), href: null, children: {}, isOpen: false, isActive: false, order: Infinity };
      }

      if (i === parts.length - 1) {
        current.children[part].title = label || dataTitle || formatTitle(part);
        current.children[part].href = `${basePath}/${slug.replace(/\.(md|mdx)$/i, '')}`.replace(/\/+/g, '/').replace(/\/$/, "");
        if (order !== undefined) current.children[part].order = order;
      }
      current = current.children[part];
    }
  }
  return root;
}

const treeRoot = buildTree(collection);

function markActiveAndOpen(node: any): boolean {
  node.isCurrentPage = node.href != null && normalizeForMatch(node.href) === safeCurrentPath;
  let hasActiveChild = false;
  for (const key in node.children) {
    if (markActiveAndOpen(node.children[key])) hasActiveChild = true;
  }
  node.isActive = node.isCurrentPage || hasActiveChild;
  node.isOpen = node.isActive; 
  return node.isActive;
}

markActiveAndOpen(treeRoot);

function getSortedArray(nodeChildren: Record<string, any>) {
  const arr = Object.values(nodeChildren);
  arr.sort((a, b) => {
    const vA = a.order === undefined ? Infinity : a.order;
    const vB = b.order === undefined ? Infinity : b.order;
    return vA !== vB ? vA - vB : a.title.localeCompare(b.title);
  });
  arr.forEach(child => {
    child.sortedChildren = child.children && Object.keys(child.children).length > 0 ? getSortedArray(child.children) : [];
  });
  return arr;
}

const treeArray = getSortedArray(treeRoot.children);
---


<nav class="nav">
  {treeArray.map(node => <SidebarItem node={node} />)}
</nav>

<style is:global>
  @reference "tailwindcss";

  aside.aside { @apply w-64 shrink-0 border-r border-gray-200 bg-white pt-2 pr-2; }
  .nav { @apply flex flex-col gap-1; }
  
  /* DEPTH LINE */
  .nav details > div { @apply flex flex-col gap-0.5 pl-3 ml-3 border-l border-slate-200; }

  /* `s` = summary wrapper container */
  .s { @apply flex items-center justify-between cursor-pointer select-none rounded gap-1 transition-colors text-slate-700; list-style: none; }
  .s::-webkit-details-marker { display: none; }
  
  /* `l` = standalone leaf link OR the text link inside the summary */
  .l { @apply flex-1 text-sm py-1 px-2 rounded transition-colors no-underline block text-slate-700; }
  a.l { @apply cursor-pointer; }
  span.l { @apply cursor-default; }
  
  /* `c` = chevron element */
  .c { @apply flex items-center justify-center w-7 h-7 rounded text-gray-400 shrink-0 transition-transform; }
  .c::after { content: ''; @apply w-[0.4rem] h-[0.4rem] border-r-2 border-b-2 border-current block -rotate-45 transition-transform box-border; }
  details[open] > .s .c::after { @apply rotate-45; }

  /* JS-FREE FOLDER EXPANSION */
  details:not([open]) > .s a.l { pointer-events: none; }

  /* HOVERS: Group Hover (Leaves, Closed Folders, No-Link Folders) */
  :is(a.l, details:not([open]) > .s, details:not(:has(a.l)) > .s):hover { @apply bg-slate-100; }
  a.l:hover { @apply text-indigo-600; }
  :is(details:not([open]) > .s, details:not(:has(a.l)) > .s):hover .l { @apply text-indigo-600; }

  /* HOVERS: Separate Hovers (Open Folders WITH Links) */
  details[open] > .s:has(a.l) a.l:hover { @apply bg-slate-100 text-indigo-600; }
  details[open] > .s:has(a.l) .c:hover { @apply bg-slate-100 text-slate-700; }

  /* ACTIVE & ANCESTOR STATES */
  .l[aria-current="page"], .s:has(> .l[aria-current="page"]) .l { @apply font-semibold text-indigo-600 bg-indigo-50; }
  .l[data-a], .s[data-a] .l { @apply font-semibold text-slate-900; }
  .s:has(> [aria-current="page"]) .c, details:has([aria-current="page"]) > .s .c { @apply text-indigo-500; }

  /* --- DARK MODE --- */
  .dark aside.aside { @apply border-gray-800 bg-gray-900; }
  
  /* Dimmed inactive text to increase contrast with bold active items */
  .dark :is(.l, .s) { @apply text-slate-400; }
  
  /* Dark mode border color for the depth line */
  .dark .nav details > div { @apply border-slate-700; }
  
  .dark :is(a.l, details:not([open]) > .s, details:not(:has(a.l)) > .s):hover { @apply bg-slate-800; }
  .dark a.l:hover { @apply text-indigo-400; }
  .dark :is(details:not([open]) > .s, details:not(:has(a.l)) > .s):hover .l { @apply text-indigo-400; }
  
  .dark details[open] > .s:has(a.l) a.l:hover { @apply bg-slate-800 text-indigo-400; }
  .dark details[open] > .s:has(a.l) .c:hover { @apply bg-slate-800 text-slate-200; }
  
  .dark .l[aria-current="page"], 
  .dark .s:has(> .l[aria-current="page"]) .l { @apply text-indigo-400 bg-indigo-950/40; }
  
  .dark .l[data-a], 
  .dark .s[data-a] .l { @apply text-white; }
</style>
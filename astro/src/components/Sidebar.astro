---
import SidebarItem from './SidebarItem.astro';

interface Props {
  frontmatter: Record<string, any>;
  collection: CollectionEntry[];
  basePath: String;
}

const { frontmatter, collection, basePath } = Astro.props;

const normalizeForMatch = (p: string | null) => {
  if (!p) return "";
  let clean = decodeURI(p);
  if (clean.startsWith(basePath)) {
    clean = clean.substring(basePath.length);
  }
  return clean.replace(/\.(md|mdx|html)$/i, '').replace(/\/index$/i, '').replace(/^\/+|\/+$/g, '');
};

const safeCurrentPath = normalizeForMatch(Astro.url.pathname);
const formatTitle = (str: string) => str.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

function buildTree(pages: CollectionEntry[]) {
  const root: any = { children: {}, title: 'Documentation', href: basePath, order: -1 };

  for (const page of pages) {
    const { order, hidden, title: dataTitle } = page.data;
    const label = page.data?.sidebar?.label;
    if (hidden === true) continue;

    const slug = page.slug || page.id || "";
    const parts = slug.split('/');
    let current = root;

    if (slug === "index" || slug === "") {
      root.title = label || dataTitle || root.title;
      if (order !== undefined) root.order = order;
      continue;
    }

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      const isIndexFile = part === 'index';
      const isLastPart = i === parts.length - 1;

      if (isIndexFile) {
        current.title = label || dataTitle || current.title;
        current.href = `${basePath}/${slug.replace(/\/index$/, "")}`.replace(/\/+/g, '/').replace(/\/$/, "");
        if (order !== undefined) current.order = order;
        break; 
      }

      if (!current.children[part]) {
        current.children[part] = { name: part, title: formatTitle(part), href: null, children: {}, isOpen: false, isActive: false, order: Infinity };
      }

      if (isLastPart) {
        current.children[part].title = label || dataTitle || formatTitle(part);
        current.children[part].href = `${basePath}/${slug.replace(/\.(md|mdx)$/i, '')}`.replace(/\/+/g, '/').replace(/\/$/, "");
        if (order !== undefined) current.children[part].order = order;
      }
      current = current.children[part];
    }
  }
  return root;
}

const treeRoot = buildTree(collection);

function markActiveAndOpen(node: any): boolean {
  node.isCurrentPage = node.href != null && normalizeForMatch(node.href) === safeCurrentPath;
  let hasActiveChild = false;
  for (const key in node.children) {
    if (markActiveAndOpen(node.children[key])) hasActiveChild = true;
  }
  node.isActive = node.isCurrentPage || hasActiveChild;
  node.isOpen = node.isActive; 
  return node.isActive;
}

markActiveAndOpen(treeRoot);

function getSortedArray(nodeChildren: Record<string, any>) {
  const arr = Object.values(nodeChildren);
  arr.sort((a, b) => {
    const vA = a.order === undefined ? Infinity : a.order;
    const vB = b.order === undefined ? Infinity : b.order;
    return vA !== vB ? vA - vB : a.title.localeCompare(b.title);
  });
  arr.forEach(child => {
    child.sortedChildren = child.children && Object.keys(child.children).length > 0 ? getSortedArray(child.children) : [];
  });
  return arr;
}

const treeArray = getSortedArray(treeRoot.children);
---

<aside class="aside">
  <nav class="nav">
    {treeArray.map(node => <SidebarItem node={node} />)}
  </nav>
</aside>

<style is:global>
  @reference "tailwindcss";

  /* STRUCTURE & BASE */
  .aside { @apply w-64 shrink-0 h-[calc(100vh-4rem)] sticky top-16 border-r border-gray-200 bg-white pt-2 pr-2; }
  .nav { @apply flex flex-col gap-1; }
  .kids { @apply flex flex-col gap-0.5 pl-2; }

  .row { @apply flex items-center justify-between cursor-pointer select-none rounded gap-1 transition-colors no-underline text-slate-700; }
  .row::-webkit-details-marker, .row::marker { display: none; }
  
  .link { @apply flex-1 font-medium text-sm py-1 px-2 rounded transition-colors; }
  
  .chev { @apply flex items-center justify-center w-7 h-7 rounded text-gray-400 shrink-0 transition-transform; }
  .chev::after {
    content: '';
    @apply w-[0.4rem] h-[0.4rem] border-r-2 border-b-2 border-current block -rotate-45 transition-transform box-border;
  }
  details[open] > .row .chev::after { @apply rotate-45; }

  details:not([open]) > .row a.link { pointer-events: none; }

  /* HOVERS: Group Hover (Leaves, Closed Folders, No-Link Folders) */
  :is(a.row, details:not([open]) > .row, details:not(:has(a.link)) > .row):hover { @apply bg-slate-100; }
  :is(a.row, details:not([open]) > .row, details:not(:has(a.link)) > .row):hover .link { @apply text-indigo-600; }

  /* HOVERS: Separate Hovers (Open Folders WITH Links) */
  details[open] > .row:has(a.link) .link:hover { @apply bg-slate-100 text-indigo-600; }
  details[open] > .row:has(a.link) .chev:hover { @apply bg-slate-100 text-slate-700; }

  /* ACTIVE / ANCESTOR STATES */
  .row[aria-current="page"] .link, .row:has(> .link[aria-current="page"]) .link { @apply font-semibold text-indigo-600 bg-indigo-50; }
  .row[data-anc] .link, .row:has(> .link[data-anc]) .link { @apply font-semibold text-slate-900; }
  .row:has(> [aria-current="page"]) .chev, details:has([aria-current="page"]) > .row .chev { @apply text-indigo-500; }

  /* --- DARK MODE --- */
  .dark .aside { @apply border-gray-800 bg-gray-900; }
  .dark .row { @apply text-slate-200; }
  
  .dark :is(a.row, details:not([open]) > .row, details:not(:has(a.link)) > .row):hover { @apply bg-slate-800; }
  .dark :is(a.row, details:not([open]) > .row, details:not(:has(a.link)) > .row):hover .link { @apply text-indigo-400; }
  
  .dark details[open] > .row:has(a.link) .link:hover { @apply bg-slate-800 text-indigo-400; }
  .dark details[open] > .row:has(a.link) .chev:hover { @apply bg-slate-800 text-slate-200; }
  
  .dark .row[aria-current="page"] .link, 
  .dark .row:has(> .link[aria-current="page"]) .link { @apply text-indigo-400 bg-indigo-950/40; }
  
  .dark .row[data-anc] .link, 
  .dark .row:has(> .link[data-anc]) .link { @apply text-white; }
</style>
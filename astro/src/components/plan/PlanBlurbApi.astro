---
interface Props {
  plan: 'starter' | 'essentials' | 'enterprise' | 'licensed';
  feature?: string;
  // render only the linked badge, inline
  badge?: boolean;
}
const { plan, feature, badge } = Astro.props;

const badges: Record<string, string> = {
  licensed:   'Licensed Community+ plan',
  starter:    'Starter+ plan',
  essentials: 'Essentials+ plan',
  enterprise: 'Enterprise plan',
};

const requirements: Record<string, string> = {
  licensed:   'at least a Licensed Community plan',
  starter:    'at least a Starter plan',
  essentials: 'at least an Essentials plan',
  enterprise: 'an Enterprise plan',
};

const linkHref: Record<string, string> = {
  licensed:   '/docs/concepts/plans-and-limits/plans-features#licensed-community-features',
  starter:    '/docs/concepts/plans-and-limits/plans-features#starter-features',
  essentials: '/docs/concepts/plans-and-limits/plans-features#essentials-features',
  enterprise: '/docs/concepts/plans-and-limits/plans-features#enterprise-features',
};
---
{badge ? (
  <a href={linkHref[plan]} class:list={['plan-badge', `plan-badge-${plan}`, 'no-underline']} data-plan={plan}>{badges[plan]}</a>
) : (
<p class:list={['plan-api-note', `plan-api-note-${plan}`]} data-plan={plan}>
  <strong class:list={['plan-badge', `plan-badge-${plan}`]}>{badges[plan]}</strong>{' '}
  <span>To use {feature ?? <slot />}, you'll need <a href={linkHref[plan]}>{requirements[plan]}</a>.</span>
</p>
)}

---
interface Props {
  plan: 'starter' | 'essentials' | 'enterprise' | 'licensed';
  feature?: string;
}
const { plan, feature } = Astro.props;

const badges: Record<string, string> = {
  starter:       'Starter plan',
  essentials: 'Essentials+ plan',
  enterprise: 'Enterprise plan',
  licensed:   'License required',
};

const requirements: Record<string, string> = {
  starter:       'a Starter plan',
  essentials: 'an Essentials or Enterprise plan',
  enterprise: 'an Enterprise plan',
  licensed:   'a FusionAuth license',
};

const linkText: Record<string, string> = {
  starter:       'See plans and features',
  essentials: 'See plans and features',
  enterprise: 'See plans and features',
  licensed:   'Register for a free license',
};

const linkHref: Record<string, string> = {
  starter:       '/docs/get-started/core-concepts/plans-features',
  essentials: '/docs/get-started/core-concepts/plans-features',
  enterprise: '/docs/get-started/core-concepts/plans-features',
  licensed:   'https://account.fusionauth.io/',
};
---
<p class:list={['plan-api-note', `plan-api-note-${plan}`]} data-plan={plan}>
  <span class:list={['plan-badge', `plan-badge-${plan}`]}>{badges[plan]}</span>
  <span>To use {feature ?? <slot />}, you'll need {requirements[plan]}. <a href={linkHref[plan]}>{linkText[plan]}</a>.</span>
</p>

---
import ReactorGray from 'src/components/plan/reactor-logo-gray.svg';
import ReactorWhite from 'src/components/plan/reactor-logo-white.svg';

interface Props {
  plan: 'licensed' | 'starter' | 'essentials' | 'enterprise';
  version?: string;
}
const { plan, version } = Astro.props;

const labels: Record<string, string> = {
  licensed:   'Licensed Community plan required',
  starter:    'Starter plan required',
  essentials: 'Essentials plan required',
  enterprise: 'Enterprise plan required',
};

const cssClasses: Record<string, string> = {
  licensed:   'aside-plan-licensed',
  starter:    'aside-plan-starter',
  essentials: 'aside-plan-essentials',
  enterprise: 'aside-plan-enterprise',
};

const requirements: Record<string, string> = {
  licensed:   'at least a Licensed Community plan',
  starter:    'at least a Starter plan',
  essentials: 'at least an Essentials plan',
  enterprise: 'an Enterprise plan',
};

const linkHref: Record<string, string> = {
  licensed:   '/docs/get-started/core-concepts/plans-features#licensed-community-features',
  starter:    '/docs/get-started/core-concepts/plans-features#starter-features',
  essentials: '/docs/get-started/core-concepts/plans-features#essentials-features',
  enterprise: '/docs/get-started/core-concepts/plans-features#enterprise-features',
};
---
<div class:list={['aside', cssClasses[plan]]} role="note" data-plan={plan}>
  <div class="aside-title not-prose">
    <span class="aside-icon" aria-hidden="true">
      <ReactorGray class="dark:hidden" width={24} height={24} />
      <ReactorWhite class="hidden dark:inline" width={24} height={24} />
    </span>
    <span class="mb-1 font-semibold">{labels[plan]}</span>
  </div>
  <div class="aside-content">
    <p>This feature requires <a href={linkHref[plan]}>{requirements[plan]}</a>{version ? <> as of version <code>{version}</code></> : ''}.</p>
  </div>
</div>

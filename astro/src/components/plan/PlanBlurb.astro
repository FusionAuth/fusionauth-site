---
import ReactorGray from 'src/components/plan/reactor-logo-gray.svg';
import ReactorWhite from 'src/components/plan/reactor-logo-white.svg';

interface Props {
  plan: 'paid' | 'essentials' | 'enterprise' | 'licensed';
  version?: string;
}
const { plan, version } = Astro.props;

const labels: Record<string, string> = {
  licensed:   'License required',
  paid:       'Paid plan required',
  essentials: 'At least Essentials plan required',
  enterprise: 'Enterprise plan required',
};

const cssClasses: Record<string, string> = {
  licensed:   'aside-plan-licensed',
  paid:       'aside-plan-paid',
  essentials: 'aside-plan-essentials',
  enterprise: 'aside-plan-enterprise',
};
---
<div class:list={['aside', cssClasses[plan]]} role="note" data-plan={plan}>
  <div class="aside-title not-prose">
    <span class="aside-icon" aria-hidden="true">
      <ReactorGray class="dark:hidden" width={24} height={24} />
      <ReactorWhite class="hidden dark:inline" width={24} height={24} />
    </span>
    <span class="mb-1 font-semibold">{labels[plan]}</span>
  </div>
  <div class="aside-content">
    {plan === 'paid' && <p>This feature is only available in paid plans. For more information, see <a href="/docs/get-started/core-concepts/plans-features">plans and features</a>.</p>}
    {plan === 'essentials' && <p>This feature is only available in Essentials or Enterprise plans. For more information, see <a href="/docs/get-started/core-concepts/plans-features">plans and features</a>.</p>}
    {plan === 'enterprise' && <p>This feature is only available in the Enterprise plan. For more information, see <a href="/docs/get-started/core-concepts/plans-features">plans and features</a>.</p>}
    {plan === 'licensed' && <p>This feature is available in licensed FusionAuth instances{version ? <> as of version <code>{version}</code></> : ''}. Visit the account portal to <a href="https://account.fusionauth.io/">register for a free license</a>.</p>}
  </div>
</div>

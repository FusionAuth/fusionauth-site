---
const { heading } = Astro.props;
---


<style>
  @reference "tailwindcss";
  li {
    @apply m-0 text-sm;
  }
  li {
    @apply mb-3 text-sm;
  }
  li ul {
    @apply ml-4 pt-3;
  }
  .group a {
    @apply block font-medium text-slate-600 text-sm dark:text-slate-400 dark:hover:text-slate-100 hover:text-slate-900 transition-colors
  }
  .active > a {
    @apply dark:text-indigo-400 text-indigo-600 ;
  }
</style>

<li>
  <span class="group">
  <a href={'#' + heading.slug}>
    {heading.cleanText}
  </a>
  {
    heading.subheadings.length > 0 && (
      <ul>
        {heading.subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
  </span>
</li>

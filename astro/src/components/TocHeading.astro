---
const { heading } = Astro.props;
---


<style>
  @reference "../css/style.css";
  li {
    @apply m-0 mb-3 text-sm;
  }
  li ul {
    @apply ml-4 pt-3;
  }
  .group a {
    @apply block font-medium text-slate-500 text-sm hover:text-slate-900 group-[.active]:text-indigo-600  transition-colors dark:text-slate-400 dark:group-[.active]:text-indigo-400 dark:hover:text-slate-100;
  }
  .active > a {
    @apply dark:text-indigo-200 text-indigo-600;
  }
</style>

<li>
  <span class="group">
  <a href={'#' + heading.slug}>
    {heading.cleanText}
  </a>
  </span>

  {
    heading.subheadings.length > 0 && (
      <ul>
        {heading.subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>

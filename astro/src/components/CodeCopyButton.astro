<svg aria-hidden="true" style="display:none">
  <symbol id="ccb-copy" viewBox="0 0 640 640">
    <path fill="currentColor" d="M288 64c-35.3 0-64 28.7-64 64v256c0 35.3 28.7 64 64 64h192c35.3 0 64-28.7 64-64V183.4c0-17.4-7.1-34.1-19.7-46.2l-57.7-55.4A64.1 64.1 0 0 0 422.3 64zM160 192c-35.3 0-64 28.7-64 64v256c0 35.3 28.7 64 64 64h192c35.3 0 64-28.7 64-64v-16h-64v16H160V256h16v-64z"/>
  </symbol>
  <symbol id="ccb-check" viewBox="0 0 640 640">
    <path fill="currentColor" d="M530.8 134.1c14.3 10.4 17.5 30.4 7.1 44.7l-256 352c-5.5 7.6-14 12.3-23.4 13.1s-18.5-2.7-25.1-9.3l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l101.5 101.5l234-321.7c10.4-14.3 30.4-17.5 44.7-7.1z"/>
  </symbol>
</svg>

<script>
  const svgUse = (id: string) =>
    `<svg width="16" height="16" fill="currentColor" aria-hidden="true"><use href="${id}"/></svg>`;

  class CopyCodeButton extends HTMLElement {
    #timeout: number | undefined;

    connectedCallback() {
      this.innerHTML = `<button class="ccb-btn" title="Copy contents">${svgUse('#ccb-copy')}</button>`;
      this.querySelector('button')!.addEventListener('click', () => this.#handleCopy());
    }

    #handleCopy() {
      const wrapper = this.closest('.relative.group') as HTMLElement | null;
      const pre = wrapper?.querySelector('pre');
      const code = wrapper?.querySelector('code');
      if (!code) return;

      // Build text from .line spans (excluding collapse toggles) or fall back to innerText
      const lineSpans = code.querySelectorAll<HTMLElement>('.line:not(.line-collapse-toggle)');
      let text = lineSpans.length
        ? Array.from(lineSpans).map(s => s.innerText).join('\n')
        : code.innerText;
      if (pre?.classList.contains('language-shell-session')) {
        text = text.split('\n').map(line =>
          (line.startsWith('$ ') || line.startsWith('# ')) ? line.slice(2) : line
        ).join('\n');
      }

      navigator.clipboard.writeText(text).then(() => {
        const btn = this.querySelector('button')!;
        btn.innerHTML = svgUse('#ccb-check');
        wrapper!.classList.add('active');
        clearTimeout(this.#timeout);
        this.#timeout = window.setTimeout(() => {
          btn.innerHTML = svgUse('#ccb-copy');
          wrapper!.classList.remove('active');
        }, 1500);
      }).catch(err => console.error('Failed to copy:', err));
    }
  }

  if (!customElements.get('copy-code-button')) {
    customElements.define('copy-code-button', CopyCodeButton);
  }

  // Collapse toggle: clicking a .line-collapse-toggle shows/hides the following .line-collapsed spans
  document.querySelectorAll('.line-collapse-toggle').forEach(toggle => {
    // Populate data-preview with the first hidden line's text so CSS can show a faint hint
    const firstHidden = toggle.nextElementSibling;
    if (firstHidden?.classList.contains('line-collapsed')) {
      const preview = firstHidden.textContent ?? '';
      if (preview) (toggle as HTMLElement).dataset.preview = preview;
    }

    toggle.addEventListener('click', () => {
      const expanded = toggle.classList.toggle('expanded');
      const count = (toggle as HTMLElement).dataset.count ?? '?';
      const unit = count === '1' ? 'line' : 'lines';
      if (toggle.firstChild) toggle.firstChild.textContent = expanded
        ? `hide ${count} ${unit}`
        : `${count} hidden ${unit}`;
      let sib = toggle.nextElementSibling as HTMLElement | null;
      while (sib && sib.classList.contains('line-collapsed')) {
        sib.classList.toggle('expanded', expanded);
        sib = sib.nextElementSibling as HTMLElement | null;
      }
    });
  });

  // Wrap non-MDX code blocks not already processed by rehypeCopyButton at build time
  document.querySelectorAll('pre[class*="language-"]').forEach(pre => {
    if (pre.closest('.relative.group')) return;
    const parent = pre.parentNode!;
    const wrapper = document.createElement('div');
    wrapper.className = 'relative group';
    const btn = document.createElement('copy-code-button');
    parent.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);
    wrapper.appendChild(btn);
  });
</script>

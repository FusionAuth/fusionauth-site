---
import { Marked } from "marked";

const { node } = Astro.props;
const childNodes = node.sortedChildren || [];

const remark = new Marked();
const htmlTitle = remark.parseInline(node.title);
const isAnc = node.isActive && !node.isCurrentPage;
---

{childNodes.length > 0 ? (
  <details class="folder" open={node.isOpen}>
    <summary class="row" data-anc={isAnc ? "" : undefined}>
      {node.href ? (
        <a 
          href={`${node.href}/`}
          class="link"
          aria-current={node.isCurrentPage ? "page" : undefined}
          set:html={htmlTitle}
        ></a>
      ) : (
        <span class="link cursor-default" set:html={htmlTitle}></span>
      )}
      <span class="chev"></span>
    </summary>
    
    <div class="kids">
      {childNodes.map((child: any) => <Astro.self node={child} />)}
    </div>
  </details>
) : (
  <a 
    href={node.href} 
    class="row" 
    aria-current={node.isCurrentPage ? "page" : undefined}
    data-anc={isAnc ? "" : undefined}
  >
    <span class="link" set:html={htmlTitle}></span>
  </a>
)}
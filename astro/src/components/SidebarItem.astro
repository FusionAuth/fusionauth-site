---
import { Marked } from "marked";

const { node } = Astro.props;

const childNodes = node.sortedChildren || [];
const hasChildren = childNodes.length > 0;

const isCurrent = node.isCurrentPage;
const isAncestor = node.isActive && !isCurrent;

const stateClass = isAncestor ? "s-anc" : "";

const remark = new Marked();
const markdownifiedTitle = remark.parseInline(node.title);
---

{hasChildren ? (
  <details class="sb-folder" open={node.isOpen}>
    <summary class={`sb-sum ${node.href ? '' : 'sb-no-link'}`}>
      {node.href ? (
        <a 
          href={`${node.href}/`}
          class={`sb-lnk ${stateClass}`}
          aria-current={isCurrent ? "page" : undefined}
          set:html={markdownifiedTitle}
        >
        </a>
      ) : (
        <span class={`sb-lnk cursor-default ${stateClass}`} set:html={markdownifiedTitle}></span>
      )}
      <span class="sb-chv"></span>
    </summary>
    
    <div class="sb-kids">
      {childNodes.map((child: any) => <Astro.self node={child} />)}
    </div>
  </details>
) : (
  <a 
    href={node.href} 
    aria-current={isCurrent ? "page" : undefined}
    class={`sb-child ${stateClass}`}
    set:html={markdownifiedTitle}
  >
  </a>
)}
---
import { NavBar } from 'astro-better-nav-bar';
import FusionAuthLogo from 'src/components/FusionAuthLogo.astro';
import MobileMenuIcon from 'src/components/icon/MobileMenuIcon.astro';

interface Props {
  darkModeToggle?: boolean;
  hideSidebarToggle?: boolean;
  breadcrumbs?: { title: string; href: string }[];
  [key: string]: unknown;
}

const { darkModeToggle = false, hideSidebarToggle = false, breadcrumbs = [] } = Astro.props;

const moreItems = [
  { name: 'Docs',          href: '/docs/' },
  { name: 'Articles',      href: '/articles/' },
  { name: 'Blog',          href: '/blog/' },
  { name: 'Release Notes', href: '/docs/release-notes' },
  { name: 'Install',       href: '/docs/get-started/download-and-install/docker' },
];
---
<NavBar
  sectionTitle="Docs"
  sectionTitleHref="/docs"
  dropdowns={[{ label: 'Resources', items: moreItems }]}
  showThemeSelector={darkModeToggle}
  showSearch
  loginHref="https://account.fusionauth.io/account/"
  ctaHref="/contact"
  ctaLabel="Get a demo"
  breadcrumbs={breadcrumbs}
>
  <FusionAuthLogo slot="logo" class="size-10 text-white" />
  {!hideSidebarToggle && (
    <label
      for="sidebar-toggle"
      slot="sidebar-toggle"
      class="flex h-7 w-7 hover:bg-gray-700 [&>svg]:hover:stroke-indigo-500 items-center justify-center rounded transition-colors cursor-pointer"
      aria-label="Show Menu"
    >
      <MobileMenuIcon />
    </label>
  )}
</NavBar>

---
import { NavBar } from 'astro-better-nav-bar';
import FusionAuthLogo from 'src/components/FusionAuthLogo.astro';

interface Props {
  darkModeToggle?: boolean;
  breadcrumbs?: { title: string; href: string }[];
}

const { darkModeToggle = true, breadcrumbs = [] } = Astro.props;

const categoryItems = [
  { name: 'Tutorials',       href: '/blog/category/tutorial/' },
  { name: 'Release Updates', href: '/blog/category/release-updates/' },
  { name: 'Features',        href: '/blog/category/product/' },
  { name: 'Comparison',      href: '/blog/category/compare/' },
  { name: 'Customers',       href: '/blog/category/customers/' },
  { name: 'Community',       href: '/blog/category/community/' },
  { name: 'Education',       href: '/blog/category/education/' },
  { name: 'News',            href: '/blog/category/news/' },
];

const moreItems = [
  { name: 'Docs',          href: '/docs/' },
  { name: 'Articles',      href: '/articles/' },
  { name: 'Blog',          href: '/blog/' },
  { name: 'Release Notes', href: '/docs/release-notes' },
  { name: 'Download',      href: '/download' },
];
---
<NavBar
  sectionTitle="Blog"
  sectionTitleHref="/blog"
  dropdowns={[
    { label: 'Resources',  items: moreItems },
    { label: 'Categories', items: categoryItems },
  ]}
  showThemeSelector={darkModeToggle}
  showSearch
  loginHref="https://account.fusionauth.io/account/"
  ctaHref="/contact"
  ctaLabel="Get a demo"
  breadcrumbs={breadcrumbs}
>
  <FusionAuthLogo slot="logo" class="size-10 text-white" />
</NavBar>

---
import NavButton from './buttons/NavButton.astro';
import { specialCaps } from '../../tools/string';

import FusionAuthLogo from 'src/components/FusionAuthLogo.astro';
import MobileMenuIcon from 'src/components/icon/MobileMenuIcon.astro';

interface HeaderItem { name: string; href: string; }
interface Button { key: string; mobile?: boolean; }
interface Props {
  breadcrumbs?: any[];
  sectionTitle: string;
  sectionTitleHref: string;
  categoryItems: HeaderItem[];
  moreItems: HeaderItem[];
  categoryLabel: string;
  buttons: Button[];
  colorThemeOverride: string;
  noSideNav?: boolean;
  hideSidebarToggle?: boolean;      
  hideMobileCategories?: boolean;   
}

const { 
  sectionTitle, breadcrumbs, sectionTitleHref, categoryItems, moreItems, 
  categoryLabel, buttons, colorThemeOverride, noSideNav, 
  hideSidebarToggle, hideMobileCategories 
}: Props = Astro.props;

const logoColorClass = colorThemeOverride === "light" ? "text-[#334155]" 
                     : colorThemeOverride === "dark"  ? "text-white" 
                     : "text-[#334155] dark:text-white";

// Track which menu is the category menu for targeting later
const menus = [
  { items: categoryItems, label: categoryLabel, isCategory: true },
  { items: moreItems, label: 'Resources', isCategory: false }
];

const mobileButtons = buttons?.filter(b => b.mobile || ['search', 'dark-mode'].includes(b.key)) || [];
---

<div id="main-header" class="bg-slate-900 block border-b border-solid border-slate-600 lg:sticky sticky top-0 z-50 xl:shadow-lg text-left">
  <div class="hidden lg:flex justify-between items-center max-w-[90rem] mx-auto px-4 py-2 2xl:container">

    <!-- Brand -->
    <div class="flex items-center">
      <a href="/" class="ease-in mr-1 opacity-100 hover:opacity-70 transition-opacity" aria-label="Link to Main FusionAuth Website">
        <FusionAuthLogo class={`size-10 ${logoColorClass}`} />
      </a>
      <span class="font-light text-2xl text-slate-500">/</span>
      <a href={sectionTitleHref} class="ease-in font-bold hover:text-slate-400 ml-2 text-2xl text-white tracking-tight transition-colors">
        <span>{sectionTitle}</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav id="header-nav" class="flex items-center ml-auto p-0 z-50">
      {menus.map(menu => menu.items?.length > 0 && (
        <details class="group relative mx-3 flex flex-col justify-center">
          <summary class="list-none flex items-center gap-1 text-sm font-medium text-white hover:text-indigo-500 cursor-pointer after:content-[''] after:inline-block after:w-1.5 after:h-1.5 after:border-r-2 after:border-b-2 after:border-current after:ml-1 after:mb-0.5 after:rotate-45 after:transition-transform group-open:after:-rotate-[135deg] group-open:after:translate-y-0.5 [&::-webkit-details-marker]:hidden">
            {menu.label}
          </summary>
          
          <div class="absolute right-0 top-full mt-3 w-48 bg-white dark:bg-slate-900 border border-slate-500 dark:border-slate-800 rounded-md shadow-xl overflow-hidden z-50">
            <ul class="flex flex-col m-0 p-0">
              {menu.items.map(item => (
                <li class="m-0 p-0 text-sm font-medium text-slate-700 dark:text-slate-200">
                  <a class="block w-full py-2 px-4 transition-colors hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400" href={item.href}>
                    {item.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      ))}
    </nav>

    <!-- Desktop Action Buttons -->
    <div class="flex items-center ml-2 gap-2">
      {buttons?.map(button => <NavButton name={button.key}/>)}
    </div>

  </div>

  <!-- Mobile Sticky Nav Bar -->
  {!noSideNav &&
    <div id="nested-mobile-nav" class="flex lg:hidden sticky top-0 z-50 mx-auto px-4 py-2 w-full items-center">
      
      <!-- Mobile Sidebar Toggle -->
      {!hideSidebarToggle && (
        <div class="mr-3 flex items-center shrink-0">
          <button data-widget="visibility-button" data-element="side-nav" class="flex h-7 w-7 hover:bg-gray-700 [&>svg]:hover:stroke-indigo-500 items-center justify-center rounded transition-colors" aria-label="Show Menu">
            <MobileMenuIcon />
          </button>
        </div>
      )}

      <!-- Mobile Dropdowns (Moved to the left side!) -->
      <div class="flex items-center gap-2 shrink-0">
        {menus.map(menu => (menu.items?.length > 0 && !(hideMobileCategories && menu.isCategory)) && (
          <details class="group relative">
            <summary class="list-none flex items-center px-2 py-1.5 text-[11px] uppercase tracking-wide font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 rounded border border-slate-600 transition-colors cursor-pointer after:content-[''] after:inline-block after:w-1 after:h-1 after:border-r-2 after:border-b-2 after:border-current after:ml-1.5 after:mb-[2px] after:rotate-45 after:transition-transform group-open:after:-rotate-[135deg] group-open:after:translate-y-[2px] [&::-webkit-details-marker]:hidden">
              <span>{menu.label}</span>
            </summary>
            
            {/* NOTE: Changed right-0 to left-0 so the menu pops out to the right instead of off the screen! */}
            <div class="absolute left-0 top-full mt-3 w-48 bg-white dark:bg-slate-900 border border-slate-500 dark:border-slate-800 rounded-md shadow-xl overflow-hidden z-[60]">
              <ul class="flex flex-col m-0 p-0">
                {menu.items.map(item => (
                  <li class="m-0 p-0 text-sm font-medium text-slate-700 dark:text-slate-200">
                    <a class="block w-full py-2 px-4 transition-colors hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400" href={item.href}>
                      {item.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))}
      </div>
        
      <!-- Breadcrumbs -->
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="flex-1 min-w-0 mx-3 overflow-x-auto [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden">
          <nav>
            <ul class="flex items-center m-0 p-0 whitespace-nowrap">
              {breadcrumbs.map((crumb, idx) => <>
                <li class="inline-block list-none font-medium hover:text-indigo-600 text-slate-400 text-sm capitalize">
                  <a href={crumb.href}>{specialCaps(crumb.title)}</a>
                </li>
                {(idx < breadcrumbs.length - 1) && <span class="mx-2 text-slate-400">/</span>}
              </>)}
            </ul>
          </nav>
        </div>
      )}

      <!-- Mobile Actions (Theme, Search - Pushed to the right by ml-auto) -->
      <div class="ml-auto flex items-center gap-2 shrink-0">
        {mobileButtons.map(button => button.key === 'search' ? (
          <div class="flex h-7 w-7 items-center justify-center rounded hover:bg-gray-700 cursor-pointer transition-colors">
            <NavButton name={button.key}/>
          </div>
        ) : (
          <NavButton name={button.key}/>
        ))}
      </div>
      
    </div>
  }
</div>

<script>
  document.addEventListener('click', (event) => {
    const header = document.getElementById('main-header');
    if (!header) return;

    const clickedDetails = (event.target as HTMLElement).closest('details');
    header.querySelectorAll('details[open]').forEach(details => {
      if (details !== clickedDetails) {
        details.removeAttribute('open');
      }
    });
  });
</script>
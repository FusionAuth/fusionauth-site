---
import Default from './Default.astro';
import DocsNav from '../components/nav/DocsNav.astro';
import Sidebar from 'astro-better-docs-sidebar/Sidebar.astro';
import { Category } from '../tools/docs';
import { getCollection } from 'astro:content';

let { frontmatter, navContext, noSideNav } = Astro.props;

const openGraphImage = '/img/og/docs-developers-v1.png'

const docsCollection = await getCollection('docs');
const basePath = '/docs';

const breadcrumbs = [];
breadcrumbs.push({href: Astro.url.pathname, title: frontmatter.title});
---
<Default {frontmatter}
         contribute={true}
         {openGraphImage}
         maxTocDepth={4}
         {...Astro.props}>
  <DocsNav {noSideNav} slot="nav" darkModeToggle={true} />
  <Sidebar slot="sideNav" {frontmatter} collection={docsCollection} {basePath} folderBehavior="overview" />
  <slot></slot>
</Default>

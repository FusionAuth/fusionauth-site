---
import Default from './Default.astro';
import DocsNav from '../components/nav/DocsNav.astro';
import Sidebar from 'src/components/Sidebar.astro';
import { Category } from '../tools/docs';
import { getCollection } from 'astro:content';
import TOC from 'src/components/TOC.astro';

let { frontmatter, headings, jsToc=false, navContext, noSideNav } = Astro.props;

const openGraphImage = '/img/og/docs-developers-v1.png'

const docsCollection = await getCollection('docs');
const basePath = '/docs'; 

const breadcrumbs = [];
breadcrumbs.push({href: Astro.url.pathname, title: frontmatter.title});
---
<Default {frontmatter}
         {headings}
         contribute={true}
         {openGraphImage}
         maxTocDepth={3}
         disableTOC={Astro.props.headings.length === 0}
         {...Astro.props}>
  <DocsNav {noSideNav} slot="nav" darkModeToggle={true} />
  <Sidebar slot="sideNav" {frontmatter} collection={docsCollection} {basePath} />
  <slot></slot>
  <div slot="toc">
     <TOC headings={Astro.props.headings} {jsToc} />
  </div>
</Default>

<%= link_to 'Logout', '/logout', class: 'logout-btn', style: 'float: right; background: #dc3545; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px' %>
<p style="float: right; margin-right: 20px;">Welcome, <%= @name %></p>
<h1>Personal Note Editor</h1>
<%= form_with url: '/save' do %>
  <%= text_area_tag :content, @content, style: 'width: 100%; height: 300px; padding: 10px' %>
  <br>
  <%= button_tag 'Save Changes', style: 'padding: 10px 20px; background: #007bff; color: white; border: none' %>
<% end %>

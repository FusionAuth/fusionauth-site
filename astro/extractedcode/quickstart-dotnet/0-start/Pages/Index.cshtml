@page
@model Notes.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Notes</title>
</head>
<body>
    <h1>Notes</h1>
    <form method="post" asp-page="/Index">
        <label for="content">Your note</label><br>
        <textarea id="content" name="content" rows="8" cols="40">@Model.Note</textarea><br>
        <button type="submit">Save Changes</button>
    </form>
</body>
</html>

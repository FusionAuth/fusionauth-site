doctype html
html
  head
    meta(charset="utf-8")
    title FusionAuth Express Web
    link(rel="stylesheet", href="/static/css/moneyscope.css")
  body
    #page-container
      #page-header
        #logo-header
          img(src="/static/img/moneyscope.svg")
          .h-row
            p.header-email
            a.button-lg(href="/logout") Logout
        #menu-bar.menu-bar
          a.menu-link(href="/account") Account
      div(style="flex: 1;")
        // Application page
        .column-container
          .app-container
            h3 Your balance
            .balance $#{balanceData.balance}
    script.
      // Snag cookie user data: the userDetails cookie holds the id token, so decode its payload
      const idToken = decodeURIComponent(document.cookie.split('; ').find(c => c.startsWith('userDetails=')).split('=').at(-1))
      const user = JSON.parse(atob(idToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')))
      document.querySelector('.header-email').innerHTML = user.email;

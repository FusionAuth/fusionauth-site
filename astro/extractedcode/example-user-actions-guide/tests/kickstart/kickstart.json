{
  "variables": {
    "apiKey": "user-actions-guide-test-api-key-not-for-production",
    "applicationId": "e9fdb985-9173-4e01-9d73-ac2d60d1dc8e",
    "clientSecret": "super-secret-secret-that-should-be-regenerated-for-production",
    "adminEmail": "admin@example.com",
    "adminPassword": "password",
    "adminUserId": "00000000-0000-0000-0000-000000000001",
    "userEmail": "richard@example.com",
    "userPassword": "password",
    "userUserId": "00000000-0000-0000-0000-111111111111",
    "banActionId": "b96a0548-e87c-42dd-887c-31294ca10c8b",
    "expiredReasonId": "28b0dd40-3a65-48ae-8eb3-4d63d253180a"
  },
  "apiKeys": [
    {
      "key": "#{apiKey}",
      "description": "Test API key"
    }
  ],
  "requests": [
    {
      "method": "POST",
      "url": "/api/application/#{applicationId}",
      "body": {
        "application": {
          "name": "User actions example",
          "oauthConfiguration": {
            "authorizedRedirectURLs": ["http://localhost:3000/oauth-redirect"],
            "logoutURL": "http://localhost:3000/logout",
            "clientSecret": "#{clientSecret}",
            "enabledGrants": ["authorization_code", "refresh_token"],
            "clientAuthenticationPolicy": "Required",
            "proofKeyForCodeExchangePolicy": "Required"
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{adminUserId}",
      "body": {
        "user": {
          "email": "#{adminEmail}",
          "firstName": "Admin",
          "password": "#{adminPassword}"
        },
        "registration": {
          "applicationId": "#{FUSIONAUTH_APPLICATION_ID}",
          "roles": ["admin"]
        },
        "skipRegistrationVerification": true
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{userUserId}",
      "body": {
        "user": {
          "email": "#{userEmail}",
          "firstName": "Richard",
          "password": "#{userPassword}"
        },
        "registration": {
          "applicationId": "#{applicationId}"
        },
        "skipRegistrationVerification": true
      }
    },
    {
      "method": "POST",
      "url": "/api/user-action/#{banActionId}",
      "body": {
        "userAction": {
          "name": "Ban",
          "preventLogin": true,
          "temporal": true
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user-action-reason/#{expiredReasonId}",
      "body": {
        "userActionReason": {
          "code": "EXPIRED",
          "text": "Subscription expired"
        }
      }
    }
  ]
}

your-application
.idea
!.env

# Composer installs these from composer.lock, so they aren't committed.
complete-application/vendor/
complete-application/web/core/
complete-application/web/libraries/
complete-application/web/modules/contrib/
complete-application/web/themes/contrib/
complete-application/web/profiles/contrib/

# Scaffold files that drupal/core-composer-scaffold writes on composer install.
complete-application/web/.csslintrc
complete-application/web/.eslintignore
complete-application/web/.eslintrc.json
complete-application/web/.ht.router.php
complete-application/web/.htaccess
complete-application/web/INSTALL.txt
complete-application/web/README.md
complete-application/web/autoload.php
complete-application/web/example.gitignore
complete-application/web/index.php
complete-application/web/robots.txt
complete-application/web/update.php
complete-application/web/web.config
complete-application/web/modules/README.txt
complete-application/web/themes/README.txt
complete-application/web/profiles/README.txt
complete-application/web/sites/README.txt
complete-application/web/sites/default/default.services.yml
complete-application/web/sites/default/default.settings.php
complete-application/web/sites/development.services.yml
complete-application/web/sites/example.settings.local.php
complete-application/web/sites/example.sites.php

# Uploaded files and generated assets. The install script copies default-content/files in.
complete-application/web/sites/*/files/

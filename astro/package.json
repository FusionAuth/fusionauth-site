{
	"name": "fusionauth-site",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "bash ../src/scripts/generate-code-snippets.sh && SITE_URL=http://localhost:3000 astro dev --port 3000",
		"start": "SITE_URL=http://localhost:4321 npm run --silent build && astro preview",
		"build": "bash ../src/scripts/generate-code-snippets.sh && astro build",
		"dev-build": "bash ../src/scripts/generate-code-snippets.sh && DEV=true astro build",
		"generate-code-snippets": "bash ../src/scripts/generate-code-snippets.sh",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-pr": "node ../src/scripts/lint-recent-files.mjs",
		"test-localcode": "bash ../src/scripts/test-localcode.sh",
		"validate-code-snippets": "out=$(npx --yes bluehawk check --plugin bluehawk-languages.js --ignore 'node_modules' --ignore '.gitignore' --ignore '.DS_Store' --ignore 'package*.json' --ignore '*.lock' --ignore 'repositoryUrl.txt' --ignore 'tests' --ignore 'LICENSE' --ignore 'SECURITY.md' localcode 2>&1); status=$?; printf '%s\\n' \"$out\" | grep -v 'parsed file' | grep -v 'found binary file'; exit $status"
	},
	"dependencies": {
		"@astro-community/astro-embed-youtube": "^0.5.10",
		"@astrojs/markdown-remark": "^7.2.1",
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/prism": "^4.0.2",
		"@astrojs/rss": "^4.0.18",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/view": "^6.39.16",
		"@docsearch/css": "^4.6.2",
		"@docsearch/js": "^4.6.2",
		"@iconify-json/fa7-regular": "^1.2.3",
		"@iconify-json/fa7-solid": "^1.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.1.3",
		"astro-gen-markdown-pages": "^0.3.3",
		"astro-iconset": "^0.0.4",
		"astro-index-pages": "file:src/integrations/astro-index-pages",
		"astro-link-checker": "^0.3.1",
		"astro-mermaid-renderer-cli-smol": "^0.1.0",
		"astro-toc-smol": "^0.4.4",
		"codemirror": "^6.0.2",
		"es-toolkit": "1.46.1",
		"jose": "^6.2.3",
		"js-yaml": "^4.1.1",
		"jsonpath-plus": "^10.4.0",
		"jsonwebtoken-esm": "^1.0.5",
		"marked": "^17.0.3",
		"marked-plaintify": "^1.1.1",
		"mermaid": "^11.14.0",
		"prismjs": "^1.30.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"remark-mdx": "^3.1.1",
		"semver": "^7.7.4",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/parser": "^8.56.1",
		"eslint": "^10.2.0",
		"eslint-plugin-astro": "^1.6.0",
		"eslint-plugin-mdx": "^3.7.0",
		"globals": "^17.4.0",
		"svgdom": "^0.1.28",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.56.1"
	},
	"overrides": {
		"@scalar/astro": {
			"astro": "$astro"
		},
		"unified-engine": {
			"glob": "^13.0.0"
		},
		"@npmcli/map-workspaces": {
			"glob": "^13.0.0"
		},
		"@npmcli/package-json": {
			"glob": "^13.0.0"
		}
	}
}

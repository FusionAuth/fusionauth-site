{
	"name": "fusionauth-site",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "SITE_URL=http://localhost:3000 astro dev --port 3000",
		"start": "SITE_URL=http://localhost:4321 npm run --silent build && astro preview",
		"build": "astro build",
		"dev-build": "DEV=true astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint",
		"lint-pr": "node ../scripts/lint-recent-files.mjs",
		"check-redirects": "node ../scripts/check-redirects.mjs",
		"test-extractedcode": "bash ../scripts/test-extractedcode.sh",
		"validate-code-snippets": "out=$(npx --yes bluehawk check --plugin bluehawk-languages.js --ignore 'node_modules' --ignore 'vendor' --ignore '.gitignore' --ignore '.DS_Store' --ignore 'package*.json' --ignore '*.lock' --ignore 'repositoryUrl.txt' --ignore 'tests' --ignore 'LICENSE' --ignore 'SECURITY.md' extractedcode 2>&1); status=$?; printf '%s\\n' \"$out\" | grep -v 'parsed file' | grep -v 'found binary file'; exit $status",
		"screenshots": "screenshots/node_modules/.bin/take-screenshots",
		"check-screenshots": "screenshots/node_modules/.bin/check-screenshots"
	},
	"dependencies": {
		"@algolia/autocomplete-js": "^1.19.13",
		"@algolia/autocomplete-theme-classic": "^1.19.13",
		"@astro-community/astro-embed-youtube": "^0.5.10",
		"@astrojs/markdown-satteri": "^0.4.10",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/prism": "^4.1.2",
		"@astrojs/rss": "^4.0.19",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/view": "^6.43.15",
		"@fontsource-variable/inter": "5.3.0",
		"@iconify-json/fa7-regular": "^1.2.3",
		"@iconify-json/fa7-solid": "^1.2.5",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"algoliasearch": "^5.65.0",
		"astro": "^7.4.13",
		"astro-better-admonitions": "^0.3.0",
		"astro-better-cards": "^1.0.3",
		"astro-better-code-blocks": "^0.2.5",
		"astro-better-code-snippet-extractor": "^0.3.1",
		"astro-better-declarative-screenshots": "^0.7.0",
		"astro-better-details": "^0.1.4",
		"astro-better-docs-sidebar": "^1.1.1",
		"astro-better-gen-markdown-pages": "^1.3.0",
		"astro-better-glossary": "^0.1.1",
		"astro-better-lightbox": "^0.1.1",
		"astro-better-link-checker": "^1.0.1",
		"astro-better-mermaid": "^0.6.0",
		"astro-better-nav-bar": "^0.3.0",
		"astro-better-og-images": "^0.1.1",
		"astro-better-release-notes": "^0.4.1",
		"astro-better-steps": "^0.2.0",
		"astro-better-tables": "^0.2.0",
		"astro-better-tabs": "^1.1.0",
		"astro-better-toc": "^1.2.1",
		"astro-iconset": "^0.0.6",
		"codemirror": "^6.0.2",
		"github-slugger": "^2.0.0",
		"hast-util-to-string": "^3.0.1",
		"jose": "^6.2.18",
		"js-yaml": "^5.5.0",
		"jsonpath-plus": "^11.3.0",
		"jsonwebtoken-esm": "^1.0.5",
		"marked": "^18.2.1",
		"marked-plaintify": "^1.1.1",
		"mermaid": "^11.17.2",
		"prismjs": "^1.30.0",
		"semver": "^7.8.6",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.15.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-mdx": "^3.10.1",
		"globals": "^17.14.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0"
	},
	"overrides": {
		"@scalar/astro": {
			"astro": "$astro"
		},
		"unified-engine": {
			"glob": "^13.0.0"
		},
		"@npmcli/map-workspaces": {
			"glob": "^13.0.0"
		},
		"@npmcli/package-json": {
			"glob": "^13.0.0"
		}
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
